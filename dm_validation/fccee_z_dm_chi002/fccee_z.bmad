!+
! Translated from MADX to Bmad by madx_to_bmad.py
! File: fccee_z.madx
!-
! Custom laser attributes for the DM-only laser module (density-matrix branch).
! Patched from the original LCFA reference (see reference/xip05_2_out_cons_LCFA_reference.ave
! and README.md in this directory for the full derivation and provenance).
parameter[custom_attribute1] = LASER_XI
parameter[custom_attribute2] = LASER_WL_UM
parameter[custom_attribute3] = LASER_SIGMA_T_S
parameter[custom_attribute4] = LASER_PHI_SPAN
parameter[custom_attribute5] = LASER_STEPS
parameter[custom_attribute6] = LASER_EVERY
parameter[custom_attribute7] = LASER_OFF_AFTER
parameter[custom_attribute8] = LASER_COOL_TURNS
parameter[custom_attribute9] = LASER_SCALE_OVERLAP
parameter[custom_attribute10] = LASER_Z_CENTER
parameter[custom_attribute11] = LASER_THETA_DEG

! DM laser interaction parameters.
! LASER_WL_UM is READ but IGNORED by the DM-only laser_tracking_mod.f90 -- the DM
! lookup tables are built at a fixed 1064 nm (see dm_interp_mod.f90); it is left
! set here only so this file still parses against the original LCFA module if
! ever needed. LASER_THETA_DEG is NEW and REQUIRED by the DM module (hard stop
! if absent) since the DM table is indexed on crossing angle explicitly, unlike
! the LCFA path's head-on-collision formula.
! LASER_XI is set to the value giving chi_e = 0.002 at 1064 nm, theta=10 deg,
! E=45.6 GeV (see README.md) -- NOT the original 10.6 um/xi=0.1 CO2 values,
! which are a different (wavelength, xi) pair that happened to also give
! chi_e ~ 0.002-0.004 for that laser. Per the LCFA formalism, only the
! resulting chi_e (not the specific wavelength) determined the physics in the
! original reference run, so this substitution targets the same chi_e.
! LASER_Z_CENTER = z-position of laser pulse center (typically closed orbit z at IP)
! LASER_XI controlled by ramper in laser_ramper_expression.bmad
laser_ip: marker, LASER_XI := 0.0, LASER_WL_UM := 10.6, LASER_SIGMA_T_S := 35.0e-15, &
          LASER_PHI_SPAN := 0.12, LASER_STEPS := 100, LASER_EVERY := 1, &
          LASER_OFF_AFTER := 0, LASER_COOL_TURNS := 0, LASER_SCALE_OVERLAP := 1, &
          LASER_Z_CENTER := 0.21, LASER_THETA_DEG := 10.0


